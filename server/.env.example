# Copy to .env and adjust if needed (defaults shown)
PORT=3000
ROSBRIDGE_URL=ws://localhost:9090
ROSBRIDGE_RECONNECT_MS=2000

# Optional: serve over HTTPS so a VR headset on your network can use WebXR.
# See README "Viewing in VR". Both must be set to enable HTTPS.
# HTTPS_KEY=../certs/key.pem
# HTTPS_CERT=../certs/cert.pem
